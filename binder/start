#!/usr/bin/env bash
set -euo pipefail

echo "[binder/start] Starting JupyterLab for Thebe/Binder runtime"
echo "[binder/start] Python: $(python3 --version 2>/dev/null || true)"
echo "[binder/start] Dotnet: $(dotnet --version 2>/dev/null || true)"
echo "[binder/start] dotnet-interactive: $(dotnet-interactive --version 2>/dev/null || true)"

exec jupyter lab \
  --ip=0.0.0.0 \
  --port=8888 \
  --no-browser \
  --ServerApp.token='' \
  --ServerApp.password='' \
  --ServerApp.allow_origin='*'