+tabs19_invalid_solution
+// Solution: reject unknown services
+using System;
+string service = "X"; // Test "P" as well as "X".
+int charge = 0;
+
+switch (service)
+{
+    case "E": charge = 8; break;
+    case "S": charge = 3; break;
+    case "P": charge = 0; break;
+    default:
+        Console.WriteLine("Unknown service");
+        return;
+}
+
+if (charge == 0)
+{
+    Console.WriteLine("Free pickup.");
+}
+else
+{
+    Console.WriteLine($"Service {service}: {charge}");
+}
+
