+/* @theme thinkpress-lecture */
+
+/*
+ * ThinkPress lecture theme (HTML output). The PowerPoint builder (build.mjs)
+ * mirrors these sizes. Sizes are for classroom projection: body text at
+ * least 28px, code at least 24px on a 1280x720 slide.
+ * Per-book colors: override --primary and --accent in the deck's `style:`.
+ */
+
+@import 'default';
+
+section {
+  --primary: #2a6b37;
+  --accent: #b8860b;
+  --tint: #eef5ef;
+  --text: #1f2328;
+  --muted: #59636e;
+  width: 1280px;
+  height: 720px;
+  padding: 48px 64px 56px 64px;
+  font-family: Calibri, 'Segoe UI', system-ui, sans-serif;
+  font-size: 28px;
+  line-height: 1.35;
+  color: var(--text);
+  background: #ffffff;
+  justify-content: flex-start !important;
+  /* Marp's default theme centers block content vertically (align-content: safe center),
+     which puts short slides' titles lower than long ones. Pin content to the top. */
+  align-content: start !important;
+}
+
+h1, h2 {
+  font-family: Cambria, Georgia, serif;
+  color: var(--primary);
+  font-size: 40px;
+  margin: 0 0 20px 0;
+}
+h3 { color: var(--accent); font-size: 28px; margin: 12px 0 8px 0; }
+ul, ol { margin: 0 0 0 1em; padding: 0; }
+li { margin-bottom: 10px; }
+strong { color: var(--primary); }
+code { font-family: Consolas, 'Courier New', monospace; font-size: 0.9em; background: #f3f4f6; padding: 1px 6px; border-radius: 4px; }
+pre { font-size: 24px; line-height: 1.3; background: #f6f8fa; border-radius: 10px; padding: 16px 20px; margin: 10px 0; }
+pre code { background: none; padding: 0; font-size: 1em; }
+pre.output, pre:has(code.language-output) { background: #ffffff; border: 2px dashed #c9d1d9; }
+table { font-size: 24px; border-collapse: collapse; }
+th { background: var(--primary); color: #fff; padding: 8px 14px; }
+td { padding: 8px 14px; border-bottom: 1px solid #d0d7de; }
+blockquote { background: var(--tint); border: none; border-radius: 10px; padding: 14px 20px; margin: 14px 0; color: var(--text); font-size: 26px; }
+img { max-height: 520px; }
+a, a:hover, a:focus { text-decoration: none; }
+a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
+a:hover { background: var(--tint); }
+section::after { font-size: 18px; color: var(--muted); }
+
+/* Two columns: wrap each column in <div class="col"> ... </div> */
+.cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
+
+/* Title and section dividers */
+section.title, section.section, section.recap {
+  background: var(--primary);
+  color: #ffffff;
+  justify-content: center !important;
+  align-content: center !important;
+}
+section.title h1, section.section h1, section.section h2, section.recap h2 { color: #ffffff; font-size: 56px; }
+section.title p, section.section p { color: #dfeee2; font-size: 30px; }
+section.recap li, section.recap p { color: #ffffff; }
+section.recap strong { color: #ffe9a8; }
+section.title strong, section.section strong { color: #ffe9a8; }
+section.title a, section.section a, section.recap a { color: #ffe9a8; }
+section.title a:hover, section.section a:hover, section.recap a:hover { background: rgba(255,255,255,0.15); }
+section.title code, section.section code, section.recap code { background: rgba(255, 255, 255, 0.18); color: #ffffff; }
+
+/* Quick check: question then lettered choices */
+section.check h2::before { content: '\2713  '; color: var(--accent); }
+section.check ol { list-style: upper-alpha; }
+section.check li { background: var(--tint); border-radius: 10px; padding: 10px 16px; margin: 0 0 12px 0; list-style-position: inside; }
+
+/* Your turn: a short practice prompt */
+section.yourturn h2::before { content: '\270E  '; color: var(--accent); }
