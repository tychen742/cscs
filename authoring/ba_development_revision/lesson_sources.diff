+var right = new Amount(7.50m);
+Console.WriteLine((left + right).Value.ToString("F2", CultureInfo.InvariantCulture));
+Console.WriteLine($"left={left.Value.ToString("F2", CultureInfo.InvariantCulture)}, right={right.Value.ToString("F2", CultureInfo.InvariantCulture)}");
+Console.WriteLine((new Amount(0m) + right).Value.ToString("F2", CultureInfo.InvariantCulture));
+public readonly struct Amount
