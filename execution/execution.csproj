<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- The C# runner and its template are separate projects (see runner/Dockerfile). -->
  <ItemGroup>
    <Compile Remove="runner-template/**;runner/**;gateway/**" />
    <Content Remove="runner-template/**;runner/**;gateway/**" />
    <EmbeddedResource Remove="runner-template/**;runner/**;gateway/**" />
    <None Remove="runner-template/**;runner/**;gateway/**" />
  </ItemGroup>
</Project>
