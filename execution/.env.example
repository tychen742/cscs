# Copy to .env for local development. Never commit .env or real credentials.
CSCS_DB_PATH=/data/cscs.db
CSCS_DATA_PROTECTION_PATH=/data/keys
CSCS_BOOK_ROOT=/workspace
CSCS_BACKUP_ROOT=/data/notebook-backups
CSCS_ADMIN_EMAILS=
CSCS_ALLOWED_ORIGINS=https://thinkcscs.org,https://www.thinkcscs.org,http://localhost:3000,http://localhost:8000

# IONOS SMTP
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=support@thinkcscs.org
SMTP_FROM=support@thinkcscs.org
SMTP_PASSWORD=
