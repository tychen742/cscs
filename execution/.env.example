# Copy to .env for local development. Never commit .env.
# Accounts, sign-in, and reading progress live in Press (press/docs/RUN_PASSES.md).

# Press pass public key(s): comma-separated PEM bodies printed by Press's
# `manage.py create_run_pass_key`. Public, not secret. Empty means every reader
# runs code as a guest and browser authoring is unavailable.
CSCS_RUN_PASS_PUBLIC_KEYS=

# Optional run limits for cs-runner (defaults shown).
# CSCS_MAX_CONCURRENT_EXECUTIONS=2
# CSCS_GUEST_CONCURRENT_EXECUTIONS=1
# CSCS_GUEST_RUNS_PER_MINUTE=30
# CSCS_SIGNED_IN_RUNS_PER_MINUTE=30

# Host SSH directory mounted read-only into execution-api for authoring commits.
# Defaults to /home/tychen/.ssh (server).
# CSCS_SSH_DIR=/Users/<you>/.ssh
